# Optional source keys. Never commit a filled .env.
SEC_USER_AGENT=EdgeFinance research contact replace-with-your-email
FRED_API_KEY=
USPTO_API_KEY=
# TIPO 個案查詢 API；只送往 tiponet.tipo.gov.tw，不會寫入原始檔或公開資料。
TIPO_API_USERNAME=
TIPO_API_PASSWORD=
# 另一套「專利商標開放資料 API」驗證碼；目前公報列舉不需要它。
TIPO_OPEN_DATA_TOKEN=
# Optional explicit model; empty uses Codex's service default, with subscription login.
EDGEFINANCE_MODEL=
